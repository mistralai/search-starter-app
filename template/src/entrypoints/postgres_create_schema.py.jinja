"""Create the pgvector extension and collection table.

Postgres analogue of ``mistral-vespa migrate``: creates the pgvector extension
and the table backing ``COLLECTION_NAME`` (idempotent).

Usage:
    python -m entrypoints.postgres_create_schema
"""

import asyncio
import os

from dotenv import load_dotenv
from search_app import create_schema

load_dotenv(override=True)


async def main() -> None:
    collection_name = os.environ.get("COLLECTION_NAME", "exampledocs")
    await create_schema(collection_name)
    print(f"Schema ready for collection '{collection_name}'.")


if __name__ == "__main__":
    asyncio.run(main())
