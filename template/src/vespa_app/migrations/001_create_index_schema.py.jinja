                        QueryField(
                            name="ranking.features.query(chunks_embeddings_avg_cosine_similarity_weight)",
                            value=5.0,
                        ),
                        QueryField(name="yql", value=_YQL_HYBRID),
                    ],
                ),
            ]
        )
