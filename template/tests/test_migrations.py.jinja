"""The Alembic chain and the runtime declaration must describe the same collection.

Nothing replays a migration chain, so the shape the store binds to is declared separately from
the revisions that built it. That is the cost of migrations over a reconciler, and this is the
check that pays it: Alembic autogenerate comparing the declaration against a database the chain
has been run on. Without it the two drift silently and the app fails at query time instead.

Runs against a database of this test run's own, and skips when Postgres is not reachable, so
`make test` works before `make setup-postgres`.
"""

import os
from collections.abc import Iterator
from pathlib import Path

import pytest
from alembic import command
from alembic.config import Config
from alembic.util.exc import AutogenerateDiffsDetected
from sqlalchemy import create_engine, text

import search_app

from search_app import postgres_dsn

_PROJECT = Path(__file__).resolve().parents[1]
_TEST_DB = f"{{ collection_name }}_migration_test_{os.getpid()}"


def _sync(dsn: str) -> str:
    return dsn.replace("postgresql://", "postgresql+psycopg://", 1)


def _admin(statements: list[str]) -> None:
    """Run against the server's default database, which is where CREATE DATABASE has to go."""
    engine = create_engine(_sync(postgres_dsn()), isolation_level="AUTOCOMMIT")
    try:
        with engine.connect() as conn:
            for statement in statements:
                conn.execute(text(statement))
    finally:
        engine.dispose()


@pytest.fixture
def migrated_database() -> Iterator[Config]:
    """A database of this run's own for the chain to build, dropped afterwards.

    The database is named on the returned `Config`, and every assertion should read it back
    from there rather than from `POSTGRES_DSN`. `env.py` calls `load_dotenv(override=True)`,
    which *mutates* `os.environ` as a side effect of running a migration -- so an env var set
    here is gone by the time the chain has run, and a test trusting it would quietly check the
    real database instead of this one.
    """
    try:
        _admin([f'DROP DATABASE IF EXISTS "{_TEST_DB}"', f'CREATE DATABASE "{_TEST_DB}"'])
    except Exception as exc:  # noqa: BLE001 - any connection failure means no server to test against
        pytest.skip(f"postgres not reachable: {exc}")

    dsn = postgres_dsn().rsplit("/", 1)[0] + f"/{_TEST_DB}"
    # pgvector is provisioned by whoever owns the database, exactly as in a real deployment.
    engine = create_engine(_sync(dsn), isolation_level="AUTOCOMMIT")
    with engine.connect() as conn:
        conn.execute(text("CREATE EXTENSION IF NOT EXISTS vector"))
    engine.dispose()

    config = Config(str(_PROJECT / "alembic.ini"))
    config.set_main_option("script_location", str(_PROJECT / "alembic"))
    # Set on the config rather than through POSTGRES_DSN, for the reason in the docstring.
    # env.py only derives the URL when the config does not already carry one.
    config.set_main_option("sqlalchemy.url", _sync(dsn))
    try:
        yield config
    finally:
        _admin([f'DROP DATABASE IF EXISTS "{_TEST_DB}" WITH (FORCE)'])


def test_chain_matches_the_runtime_declaration(migrated_database: Config) -> None:
    """`alembic check` after `upgrade head`: the revisions build what the app expects."""
    command.upgrade(migrated_database, "head")
    try:
        command.check(migrated_database)
    except AutogenerateDiffsDetected as exc:  # pragma: no cover - only on real drift
        pytest.fail(f"the Alembic chain and the declaration have drifted: {exc}")


def test_downgrade_removes_the_collection(migrated_database: Config) -> None:
    """The chain is reversible, which a plain `create table if not exists` never was."""
    command.upgrade(migrated_database, "head")
    command.downgrade(migrated_database, "base")

    url = migrated_database.get_main_option("sqlalchemy.url")
    assert url is not None
    engine = create_engine(url)
    try:
        with engine.connect() as conn:
            remaining = conn.scalar(text("SELECT to_regclass('public.{{ collection_name }}_chunks')"))
    finally:
        engine.dispose()
    assert remaining is None


def test_a_column_pending_drop_is_tolerated_for_one_release(migrated_database: Config) -> None:
    """Retiring a field takes two releases, and this is what makes the gap between them legal.

    The store names its columns explicitly in every INSERT, so a column must outlive the release
    that stopped writing it — otherwise the previous version's pods break the moment the drop
    lands. During that window the database holds a column the declaration does not, which is
    exactly what `alembic check` is built to report. `PENDING_DROP` narrows the exemption to
    named columns so the window is visible in review rather than silently tolerated.
    """
    command.upgrade(migrated_database, "head")

    url = migrated_database.get_main_option("sqlalchemy.url")
    assert url is not None
    engine = create_engine(url)
    try:
        with engine.begin() as conn:
            conn.execute(text("ALTER TABLE {{ collection_name }}_chunks ADD COLUMN legacy text"))

        # Without the entry the window reads as drift, which is what forces the unsafe one-step drop.
        with pytest.raises(AutogenerateDiffsDetected):
            command.check(migrated_database)

        # `env.py` imports the same set object, so adding to it in place is what a release would do.
        search_app.PENDING_DROP.add("{{ collection_name }}_chunks.legacy")
        try:
            command.check(migrated_database)
        finally:
            search_app.PENDING_DROP.discard("{{ collection_name }}_chunks.legacy")
    finally:
        engine.dispose()


def test_an_index_pending_drop_is_tolerated_for_one_release(migrated_database: Config) -> None:
    """The same window, for the index half of a metric change.

    `op.retune_vector_index(..., drop_old=False)` deliberately leaves the old HNSW index behind,
    because a pod on the previous metric emits an operator the new index cannot serve. The
    declaration names only the new index, so without an entry that leftover reads as drift for
    the whole expand window — the same trap the column case has.
    """
    command.upgrade(migrated_database, "head")

    url = migrated_database.get_main_option("sqlalchemy.url")
    assert url is not None
    engine = create_engine(url)
    leftover = "{{ collection_name }}_chunks_hnsw_m16_efc64_hv_l2"
    try:
        with engine.begin() as conn:
            conn.execute(
                text(
                    f"CREATE INDEX {leftover} ON {{ collection_name }}_chunks "
                    "USING hnsw (embedding halfvec_l2_ops) WITH (m=16, ef_construction=64)"
                )
            )

        with pytest.raises(AutogenerateDiffsDetected):
            command.check(migrated_database)

        search_app.PENDING_DROP.add(leftover)
        try:
            command.check(migrated_database)
        finally:
            search_app.PENDING_DROP.discard(leftover)
    finally:
        engine.dispose()


def test_check_catches_a_changed_column_type(migrated_database: Config) -> None:
    """The embedding dimension lives only in the column type, not in any index name.

    Nothing else about the table changes when it moves, so if autogenerate were not comparing
    types this would pass while the chain and the declaration disagreed on the vector width —
    and the store would fail at query time instead.
    """
    command.upgrade(migrated_database, "head")

    url = migrated_database.get_main_option("sqlalchemy.url")
    assert url is not None
    engine = create_engine(url)
    try:
        with engine.begin() as conn:
            conn.execute(text("ALTER TABLE {{ collection_name }}_chunks ALTER COLUMN embedding TYPE halfvec(512)"))
        with pytest.raises(AutogenerateDiffsDetected, match="modify_type|embedding"):
            command.check(migrated_database)
    finally:
        engine.dispose()


def test_check_catches_a_changed_server_default(migrated_database: Config) -> None:
    """`compare_server_default` is off by default, and the metadata column carries one."""
    command.upgrade(migrated_database, "head")

    url = migrated_database.get_main_option("sqlalchemy.url")
    assert url is not None
    engine = create_engine(url)
    try:
        with engine.begin() as conn:
            conn.execute(text("ALTER TABLE {{ collection_name }}_chunks ALTER COLUMN metadata SET DEFAULT '{\"a\": 1}'::jsonb"))
        with pytest.raises(AutogenerateDiffsDetected):
            command.check(migrated_database)
    finally:
        engine.dispose()
