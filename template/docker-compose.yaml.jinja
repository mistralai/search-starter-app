{% if backend == 'vespa' -%}
# Local Vespa for development.
# Query API: http://localhost:${VESPA_QUERY_PORT:-18080}  (.env VESPA_QUERY_PORT)
# Config server: http://localhost:${VESPA_CONFIG_PORT:-19072}  (.env VESPA_CONFIG_PORT)

services:
  vespa:
    image: vespaengine/vespa:latest
    container_name: {{ _copier_conf.dst_path.name }}-vespa
    hostname: {{ _copier_conf.dst_path.name }}-vespa
    ports:
      - "${VESPA_QUERY_PORT:-18080}:8080"
      - "${VESPA_CONFIG_PORT:-19072}:19071"
    volumes:
      - vespa-data:/opt/vespa/var
    environment:
      - VESPA_CONFIGSERVERS={{ _copier_conf.dst_path.name }}-vespa
      - VESPA_HOSTNAME={{ _copier_conf.dst_path.name }}-vespa
    deploy:
      resources:
        limits:
          memory: 4G
        reservations:
          memory: 2G
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:19071/state/v1/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s

volumes:
  vespa-data:
{%- else -%}
# Local Postgres + pgvector for development.
# Connection: postgresql://pg:1234@localhost:5432/postgres  (.env POSTGRES_DSN)

services:
  postgres:
    image: pgvector/pgvector:pg18
    container_name: {{ _copier_conf.dst_path.name }}-postgres
    environment:
      POSTGRES_USER: pg
      POSTGRES_PASSWORD: 1234
      POSTGRES_DB: postgres
    ports:
      - "5432:5432"
    # PGDATA on postgres:18 is /var/lib/postgresql/18/docker; mount the parent
    # so data persists across container restarts regardless of major-version bumps.
    volumes:
      - postgres-data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U pg -d postgres"]
      interval: 5s
      timeout: 3s
      retries: 10

volumes:
  postgres-data:
{%- endif %}
