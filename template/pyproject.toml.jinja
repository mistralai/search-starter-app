[project]
name = "{{ _copier_conf.dst_path.name }}"
version = "0.1.0"
description = "A Mistral Search Toolkit project"
requires-python = ">=3.12,<3.15"
dependencies = [
    # Shared across backends: the MCP server (entrypoints/mcp_server.py) is
    # backend-agnostic (routes through search_app.get_index) and ships on both.
    "fastmcp>=3.3.1",
    "httpx>=0.27",
{%- if backend == 'vespa' %}

    {# always pin to the exact search toolkit version supported. #}
    "mistralai-search-toolkit[text-splitter-langchain,vespa]==0.2.0",
{%- else %}

    {# always pin to the exact search toolkit version supported. #}
    "mistralai-search-toolkit[text-splitter-langchain,postgres]==0.2.0",

    "alembic>=1.16",
    "psycopg[binary]>=3.2",
{%- endif %}
    "python-dotenv>=0.9.9",

    {# always pin to the exact search toolkit version supported. #}
    "mistralai-workflows-plugins-search==0.6.0,<1",
    "mistralai-workflows[mistralai]>=3.0.0,<4",
    "pydantic",
]

[dependency-groups]
dev = [
    "ruff>=0.11",
    "mypy>=1.15",
    # `make test` round-trips a document through the backend; see tests/.
    "pytest>=8.0",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/entrypoints", "src/search_app", "src/examples"]
